Disable the layer-shell 0-dimension validation that breaks phosh and
other legacy clients. This is the wlroots 0.20.2 equivalent of the
Fedora 44 patch which wrapped the older return-based checks in #if 0.

In 0.20.2 the validation was refactored into
layer_surface_role_client_commit using wlr_surface_reject_pending
instead of early returns, so we wrap the two dimension checks
(desired_width and desired_height without corresponding anchors).

diff --git a/types/wlr_layer_shell_v1.c b/types/wlr_layer_shell_v1.c
--- a/types/wlr_layer_shell_v1.c
+++ b/types/wlr_layer_shell_v1.c
@@ -358,6 +358,7 @@
 
 	uint32_t anchor = surface->pending.anchor;
 
+#if 0
 	const uint32_t horiz = ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
 		ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT;
 	if (surface->pending.desired_width == 0 && (anchor & horiz) != horiz) {
@@ -376,6 +377,7 @@
 		return;
 	}
 
+#endif
 	if ((anchor & surface->pending.exclusive_edge) != surface->pending.exclusive_edge) {
 		wlr_surface_reject_pending(wlr_surface, surface->resource,
 			ZWLR_LAYER_SURFACE_V1_ERROR_INVALID_EXCLUSIVE_EDGE,
