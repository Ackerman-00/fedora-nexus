{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "general": {
      "mode": "subagent",
      "model": "opencode/glm-5.3-flash-free"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash-free"
    }
  },
  "providers": {
    "opencode": {
      "models": {
